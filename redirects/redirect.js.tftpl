var TARGETS = ${targets};

function handler(event) {
  var req = event.request;
  var host = (req.headers.host && req.headers.host.value || "").toLowerCase();
  var target = TARGETS[host] || "f3nation.com";

  var qs = [];
  for (var key in req.querystring) {
    var p = req.querystring[key];
    var values = p.multiValue ? p.multiValue : [p];
    for (var i = 0; i < values.length; i++) {
      qs.push(values[i].value === "" ? key : key + "=" + values[i].value);
    }
  }

  return {
    statusCode: 301,
    statusDescription: "Moved Permanently",
    headers: {
      location: { value: "https://" + target + req.uri + (qs.length ? "?" + qs.join("&") : "") },
      "cache-control": { value: "max-age=3600" }
    }
  };
}
